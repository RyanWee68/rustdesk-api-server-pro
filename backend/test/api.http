@baseUrl = http://localhost:12345
@username = REPLACE_WITH_USERNAME
@password = REPLACE_WITH_PASSWORD
@deviceId = REPLACE_WITH_DEVICE_ID
@deviceUuid = REPLACE_WITH_DEVICE_UUID
@apiToken = REPLACE_WITH_API_TOKEN

### 登录
POST {{baseUrl}}/api/login
Content-Type: application/json; charset=utf-8

{"username":"{{username}}","password":"{{password}}","id":"{{deviceId}}","uuid":"{{deviceUuid}}","autoLogin":true,"type":"account","deviceInfo":{"os":"windows","type":"client","name":"desktop-example"}}

### 退出登录
POST {{baseUrl}}/api/logout
Content-Type: application/json; charset=utf-8
Authorization: Bearer {{apiToken}}

{"id":"{{deviceId}}","uuid":"{{deviceUuid}}"}

### 当前用户
POST {{baseUrl}}/api/currentUser
Content-Type: application/json; charset=utf-8
Authorization: Bearer {{apiToken}}

{"id":"{{deviceId}}","uuid":"{{deviceUuid}}"}

### 地址簿
GET {{baseUrl}}/api/ab
Content-Type: application/json; charset=utf-8
Authorization: Bearer {{apiToken}}
