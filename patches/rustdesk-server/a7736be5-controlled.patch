+            let stream = accept_with(stream, Some(&tls)).await.unwrap();
+            let mut websocket = tokio_tungstenite::accept_async(stream).await.unwrap();
+            let message = websocket.next().await.unwrap().unwrap();
+            assert_eq!(
+                message,
+                tungstenite::Message::Binary(b"test-payload".to_vec())
