+        let sealed = box_::seal(&key.0, &box_::Nonce([0u8; box_::NONCEBYTES]),
+            &box_::PublicKey(pk), &client_sk);
+        let mut response = RendezvousMessage::new();
+        response.set_key_exchange(KeyExchange { keys: vec![client_pk.0.to_vec().into(), sealed.into()], ..Default::default() });
+        client.send(Bytes::from(response.write_to_bytes().unwrap())).await.unwrap();
+        let mut request = RendezvousMessage::new();
+        request.set_punch_hole_request(PunchHoleRequest { id: "target".into(), token: "test-token".into(), ..Default::default() });
+        let mut encrypt = Encrypt::new(key.clone());
+        client.send(Bytes::from(encrypt.enc(&request.write_to_bytes().unwrap()))).await.unwrap();
+        let mut reply = client.next().await.unwrap().unwrap();
+        assert!(!reply.windows(b"test-token".len()).any(|part| part == b"test-token"));
+        let mut decrypt = Encrypt::new(key);
+        decrypt.dec(&mut reply).unwrap();
+        assert!(matches!(RendezvousMessage::parse_from_bytes(&reply).unwrap().union,
+            Some(rendezvous_message::Union::PunchHoleResponse(_))));
+        server.await.unwrap();
+    }
