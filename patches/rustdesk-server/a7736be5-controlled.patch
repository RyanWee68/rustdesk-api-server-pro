+use anyhow::{bail, Context, Result};
+use hbb_common::tokio::{
+    io::{AsyncRead, AsyncWrite},
+    net::TcpStream,
+    time::{timeout, Duration},
+};
+use once_cell::sync::OnceCell;
+use std::{ffi::OsString, fs, io::Cursor, path::Path, sync::Arc};
+use tokio_rustls::{
+    rustls::{
+        self,
+        pki_types::{CertificateDer, PrivateKeyDer},
+    },
+    TlsAcceptor,
+};
+
+pub(crate) trait Transport: AsyncRead + AsyncWrite + Unpin + Send + Sync {}
+impl<T: AsyncRead + AsyncWrite + Unpin + Send + Sync> Transport for T {}
+pub(crate) type WsTransport = Box<dyn Transport>;
+static TLS: OnceCell<Option<TlsAcceptor>> = OnceCell::new();
+
+/// init 在打开监听前验证 WSS 证书，配置错误时禁止降级启动。
+pub(crate) fn init() -> Result<()> {
+    let tls = TLS.get_or_try_init(|| {
+        let nonempty = |name| std::env::var_os(name).filter(|value| !value.is_empty());
+        load(nonempty("WSS_CERT_FILE"), nonempty("WSS_KEY_FILE"))
+    })?;
+    if std::env::args().any(|argument| argument == "--require-wss") && tls.is_none() {
+        bail!("ERR-239F 已要求原生 WSS，但未配置证书和私钥");
+    }
+    Ok(())
+}
+
+/// read_file 拒绝链接和权限过宽的私钥，不在错误中输出文件内容。
+fn read_file(path: &Path, private: bool) -> Result<Vec<u8>> {
+    let metadata = fs::symlink_metadata(path).context("ERR-239F 无法读取 WSS 文件属性")?;
+    if !path.is_absolute() || !metadata.is_file() || metadata.file_type().is_symlink() {
+        bail!("ERR-239F WSS 文件必须是绝对路径的普通文件且不能是符号链接");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if fs::canonicalize(path).context("ERR-239F 无法解析 WSS 文件路径")? != path {
+            bail!("ERR-239F WSS 文件路径不能经过符号链接或包含非规范路径");
+        }
+        if private && metadata.permissions().mode() & 0o077 != 0 {
+            bail!("ERR-239F WSS 私钥不能允许组或其他用户访问");
+        }
+    }
+    #[cfg(not(unix))]
+    let _ = private;
+    if metadata.len() == 0 || metadata.len() > 1024 * 1024 {
+        bail!("ERR-239F WSS 文件为空或超过大小限制");
+    }
+    fs::read(path).context("ERR-239F 无法读取 WSS 文件")
+}
+
+/// load 只在显式提供完整证书对时启用 TLS，未配置时保持 WSS 禁用。
+fn load(cert: Option<OsString>, key: Option<OsString>) -> Result<Option<TlsAcceptor>> {
+    let (cert, key) = match (cert, key) {
+        (None, None) => return Ok(None),
+        (Some(cert), Some(key)) => (cert, key),
+        _ => bail!("ERR-239F WSS_CERT_FILE 和 WSS_KEY_FILE 必须同时设置"),
+    };
+    if fs::canonicalize(&cert).context("ERR-239F WSS 证书不存在")?
+        == fs::canonicalize(&key).context("ERR-239F WSS 私钥不存在")?
+    {
+        bail!("ERR-239F WSS 证书和私钥不能使用同一文件");
+    }
+    let cert = read_file(Path::new(&cert), false)?;
+    let key = read_file(Path::new(&key), true)?;
+    let certs = rustls_pemfile::certs(&mut Cursor::new(cert))
+        .context("ERR-239F WSS 证书 PEM 无效")?
+        .into_iter()
+        .map(CertificateDer::from)
+        .collect();
+    let mut keys = Vec::new();
+    for item in
+        rustls_pemfile::read_all(&mut Cursor::new(key)).context("ERR-239F WSS 私钥 PEM 无效")?
+    {
+        let key: PrivateKeyDer<'static> = match item {
+            rustls_pemfile::Item::RSAKey(key) => {
+                rustls::pki_types::PrivatePkcs1KeyDer::from(key).into()
+            }
+            rustls_pemfile::Item::PKCS8Key(key) => {
+                rustls::pki_types::PrivatePkcs8KeyDer::from(key).into()
+            }
+            rustls_pemfile::Item::ECKey(key) => {
+                rustls::pki_types::PrivateSec1KeyDer::from(key).into()
+            }
+            _ => continue,
+        };
+        keys.push(key);
+    }
+    if keys.len() != 1 {
+        bail!("ERR-239F WSS 私钥文件必须恰好包含一个私钥");
+    }
+    let mut config = rustls::ServerConfig::builder_with_provider(Arc::new(
+        rustls::crypto::ring::default_provider(),
+    ))
+    .with_safe_default_protocol_versions()
+    .context("ERR-239F WSS TLS 协议配置无效")?
+    .with_no_client_auth()
+    .with_single_cert(certs, keys.remove(0))
+    .context("ERR-239F WSS 证书或私钥无效或不匹配")?;
+    config.alpn_protocols = vec![b"http/1.1".to_vec()];
+    Ok(Some(TlsAcceptor::from(Arc::new(config))))
+}
+
+/// accept 只返回本进程实际完成 TLS 握手的连接，不读取代理头。
+pub(crate) async fn accept(stream: TcpStream) -> Result<WsTransport> {
+    init()?;
+    let result = accept_with(stream, TLS.get().and_then(Option::as_ref)).await;
+    if let Err(error) = &result {
+        // 上层通用错误宏只记 debug，安全拒绝必须在默认日志级别可审计。
+        hbb_common::log::warn!("{}", error);
+    }
+    result
+}
+
+/// accept_with 限制握手时间，握手失败时不回退为明文。
+async fn accept_with(stream: TcpStream, tls: Option<&TlsAcceptor>) -> Result<WsTransport> {
+    let tls = tls.context("ERR-239F WSS 未配置证书，拒绝 WebSocket 连接")?;
+    let stream = timeout(Duration::from_secs(5), tls.accept(stream))
+        .await
+        .context("ERR-239F WSS TLS 握手超时")?
+        .context("ERR-239F WSS TLS 握手失败")?;
+    Ok(Box::new(stream))
+}
