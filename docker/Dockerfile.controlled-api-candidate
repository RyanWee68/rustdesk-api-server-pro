# 构建上下文仅包含已验证程序、前端产物及入口脚本，不包含私有部署配置。
ARG RUSTDESK_API_BASE_IMAGE=rustdesk-controlled-api:must-provide
FROM ${RUSTDESK_API_BASE_IMAGE}
COPY rustdesk-api-server-pro /app/rustdesk-api-server-pro
COPY dist/ /app/dist/
COPY controlled-entrypoint.sh controlled-healthcheck.sh /app/
RUN chmod 0755 /app/rustdesk-api-server-pro /app/controlled-entrypoint.sh /app/controlled-healthcheck.sh \
    && test "$CONTROLLED_API_ONLY" = 1 \
    && test -s /app/dist/index.html
