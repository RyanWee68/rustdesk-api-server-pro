#!/bin/sh

set -eu

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    cat <<'HELP'
mock hbbr for controlled deployment lifecycle tests

This binary is only a placeholder used to validate Dockerfile, entrypoint,
healthcheck and Compose startup. It does not implement RustDesk relay protocol.
HELP
    exit 0
fi

if [ "${MUST_LOGIN:-}" != "1" ] && [ "${MUST_LOGIN:-}" != "true" ]; then
    printf 'ERR-2399 mock hbbr requires MUST_LOGIN=1\n' >&2
    exit 1
fi

if [ -z "${API_SERVER:-}" ] || [ -z "${API_INTERNAL_SECRET:-}" ]; then
    printf 'ERR-2399 mock hbbr requires API_SERVER and API_INTERNAL_SECRET\n' >&2
    exit 1
fi

key_dir="${RUSTDESK_KEY_DIR:-/data}"
mkdir -p "$key_dir"
printf 'mock-hbbr-key\n' > "$key_dir/mock_hbbr_key"

printf 'mock hbbr started: api=%s cache=%s key_dir=%s\n' "$API_SERVER" "${AUTH_CACHE_SECONDS:-}" "$key_dir"

trap 'printf "mock hbbr stopping\n"; exit 0' INT TERM
while :; do
    sleep 30 &
    wait $!
done
